# ==============================================================================
# Git Ignore Configuration for Staffspire (Monorepo / Fullstack)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/mock_emails.log

# Uploads & Media (Preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Build Outputs
dist/
dist-ssr/
build/
frontend/dist/

# OS & System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
